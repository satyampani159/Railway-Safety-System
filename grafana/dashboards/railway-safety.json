          "rawSql": "SELECT FLOOR(UNIX_TIMESTAMP(`timestamp`) / 60) * 60000 AS time, AVG(wheel_defect_flag) * 100 AS defect_rate FROM vibration_records WHERE $__timeFilter(`timestamp`) GROUP BY 1 ORDER BY 1"
