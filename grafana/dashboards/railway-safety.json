    {
      "id": 6,
      "type": "barchart",
      "title": "Avg Vibration RMS by Speed Band",
      "description": "Average X-axis RMS acceleration per speed band - green Healthy vs red Defective. Defective wheels vibrate harder in every band.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 12
      },
      "datasource": {
        "type": "mysql",
        "uid": "mysql-railway"
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "SELECT CASE WHEN speed_kmh < 40 THEN '0-40' WHEN speed_kmh < 80 THEN '40-80' WHEN speed_kmh < 120 THEN '80-120' WHEN speed_kmh < 160 THEN '120-160' ELSE '160+' END AS SpeedBand, AVG(CASE WHEN wheel_defect_flag = 0 THEN acceleration_x_rms END) AS Healthy, AVG(CASE WHEN wheel_defect_flag = 1 THEN acceleration_x_rms END) AS Defective FROM vibration_records WHERE `timestamp` BETWEEN '2024-01-01 00:00:00' AND '2024-01-01 00:15:00' GROUP BY SpeedBand ORDER BY MIN(speed_kmh)"
        }
      ],
      "fieldConfig": {
        "defaults": {
